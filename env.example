# 🚢 Ship Planning System - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# 🔑 REQUIRED VARIABLES (Must be set)
# =============================================================================

# Weather API (Get free key from https://openweathermap.org/api)
WEATHER_API_KEY=your_openweather_api_key_here

# Security (Change in production)
SECRET_KEY=your-super-secret-key-change-in-production-please

# =============================================================================
# 📊 DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL (automatically configured in Docker)
DATABASE_URL=postgresql://ship_user:ship_password@postgres:5432/ship_planning
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# =============================================================================
# 🚀 REDIS CONFIGURATION
# =============================================================================

# Redis Cache URL (automatically configured in Docker)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_WEATHER_TTL=21600

# =============================================================================
# 🤖 ML MODELS CONFIGURATION
# =============================================================================

MODEL_RETRAIN_THRESHOLD=0.85
MODEL_CACHE_TTL=1800
MODEL_VERSION=v1.0
ENABLE_CONTINUOUS_LEARNING=true

# =============================================================================
# ⚡ PERFORMANCE SETTINGS
# =============================================================================

MAX_CONCURRENT_REQUESTS=100
API_TIMEOUT=30
CACHE_DEFAULT_TTL=1800

# =============================================================================
# 📝 LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# 🔧 DEVELOPMENT SETTINGS
# =============================================================================

DEBUG=trueWhen you dockerize the application:

Keep the Docker setup simple and maintainable — avoid unnecessary complexity.

Optimize for fast startup — the container should boot quickly.

Follow best practices — simplicity and clarity should guide your configuration.
ENVIRONMENT=development

# =============================================================================
# 🌐 EXTERNAL APIS
# =============================================================================

WEATHER_API_URL=https://api.openweathermap.org/data/2.5
API_VERSION=v1 When you dockerize the application:

Keep the Docker setup simple and maintainable — avoid unnecessary complexity.

Optimize for fast startup — the container should boot quickly.

Follow best practices — simplicity and clarity should guide your configuration.